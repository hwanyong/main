<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.antigravity.inputbridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{PROJECT_ROOT}}/.venv_monitor/bin/python3</string>
        <string>-m</string>
        <string>src.ax.daemon</string>
    </array>
    <key>WorkingDirectory</key>
    <string>{{PROJECT_ROOT}}</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/.ag-input-bridge.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/.ag-input-bridge.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>{{PROJECT_ROOT}}</string>
    </dict>
</dict>
</plist>
